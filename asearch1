            if not isinstance(payload, str):
                payload = str(payload)

            if SEARCH_OBJECT_NAMES:
                add_text_matches(
                    project_key, project_name, recipe_name,
                    "Recipe ({})".format(recipe_type),
                    "recipe_name", recipe_name
                )

            # Payload'i satir numaralarini koruyarak tara.
            add_text_matches(
                project_key, project_name, recipe_name,
                "Recipe ({})".format(recipe_type),
                "recipe_payload", payload
            )

            recipe_success += 1

        except Exception as exc:
            recipe_failed += 1

            record_error(
                project_key, project_name, recipe_name,
                "Recipe ({})".format(recipe_type),
                "get_recipe/get_settings/str_payload",
                exc
            )

    # ------------------------------------------------------------
    # 3B. PYTHON / R / SCALA NOTEBOOK TARAMASI
    # ------------------------------------------------------------

