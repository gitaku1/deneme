def record_error(project_key, project_name, object_name,
                 object_type, stage, exc):
    """Hatayi kaynagi ve aciklamasiyla kaydeder."""

    message = "{}: {}".format(type(exc).__name__, str(exc))

    lower_message = message.lower()

    if "403" in lower_message or "forbidden" in lower_message:
        category = "Yetki / erisim engeli"
        suggestion = "Kullanici ve nesne erisim yetkilerini kontrol edin."
    elif "401" in lower_message or "unauthorized" in lower_message:
        category = "Kimlik dogrulama"
        suggestion = "DSS oturumunu ve kimlik dogrulamayi kontrol edin."
    elif "404" in lower_message or "not found" in lower_message:
        category = "Nesne bulunamadi"
        suggestion = "Nesne kimligini ve silinme/yeniden adlandirilma durumunu kontrol edin."
    elif isinstance(exc, (AttributeError, TypeError)):
        category = "API / nesne uyumsuzlugu"
        suggestion = "DSS 14.7.2 API metodunu ve donen nesne tipini kontrol edin."
    elif isinstance(exc, KeyError):
        category = "Eksik alan / anahtar"
        suggestion = "Ilgili nesnenin veri yapisini ve beklenen alanlarini kontrol edin."
    elif "timeout" in lower_message or "timed out" in lower_message:
        category = "Zaman asimi"
        suggestion = "DSS yanitini ve ag erisimini kontrol edin."
    elif "connection" in lower_message:
        category = "Baglanti"
        suggestion = "DSS baglantisini ve servis durumunu kontrol edin."
    else:
        category = "Diger hata"
        suggestion = "Gercek hata mesajini ve hata asamasini inceleyin."

    errors.append({
        "project_key": project_key,
        "project_name": project_name,
        "object_name": object_name,
        "object_type": object_type,
        "stage": stage,
        "error_category": category,
        "error": message,
        "suggestion": suggestion
    })


def add_text_matches(project_key, project_name, object_name,
                     object_type, source, content):
    """Metin icerisindeki eslesmeleri satir bazinda kaydeder."""

    if content is None:
        return 0

    if not isinstance(content, str):
        content = str(content)

    count = 0

    for line_number, line in enumerate(content.splitlines(), start=1):
        found = list(PATTERN.finditer(line))

        for match in found:
            left = max(0, match.start() - CONTEXT_CHARS)
            right = min(len(line), match.end() + CONTEXT_CHARS)

            matches.append({
                "project_key": project_key,
                "project_name": project_name,
                "object_name": object_name,
                "object_type": object_type,
                "source": source,
                "line_number": line_number,
                "matched_text": match.group(0),
                "line_text": line.strip(),
                "context": line[left:right].strip()
            })

            count += 1

    return count


def notebook_source_to_text(source):
    """Notebook hucre kaynagini metne cevirir."""

    if isinstance(source, list):
        return "".join(str(part) for part in source)

    if isinstance(source, str):
        return source

    return ""


def scan_python_notebook(project_key, project_name, notebook):
    """Python/R/Scala notebook kod hucrelerini tarar."""

    name = (
        getattr(notebook, "notebook_name", None)
        or getattr(notebook, "name", None)
        or "unknown_notebook"
    )

    language = (
        getattr(notebook, "language", None)
        or "unknown"
    )

    if SEARCH_OBJECT_NAMES:
        add_text_matches(
            project_key, project_name, name,
            "Code Notebook", "notebook_name", name
        )

    content = notebook.get_content()
    cells = content.get_cells()

    code_cells = 0

    for index, cell in enumerate(cells, start=1):
        if cell.get("cell_type") != "code":
            continue

        code_cells += 1

        source = notebook_source_to_text(cell.get("source", []))

        add_text_matches(
            project_key, project_name, name,
            "Code Notebook ({})".format(language),
            "cell_{}".format(index),
            source
        )

    return code_cells


def scan_sql_notebook(project_key, project_name, notebook):
    """SQL notebook hucrelerini tarar."""

    content = notebook.get_content()
    cells = content.cells

    name = (
        getattr(notebook, "id", None)
        or getattr(notebook, "notebook_id", None)
        or "unknown_sql_notebook"
    )

    language = (
        getattr(notebook, "language", None)
        or "SQL"
    )

    if SEARCH_OBJECT_NAMES:
        add_text_matches(
            project_key, project_name, str(name),
            "SQL Notebook", "notebook_name", str(name)
        )

    for index, cell in enumerate(cells, start=1):
        code = cell.get("code", "")

        add_text_matches(
            project_key, project_name, str(name),
            "SQL Notebook ({})".format(language),
            "cell_{}".format(index),
            code
        )


