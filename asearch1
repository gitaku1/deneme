if not SEARCH_TERM:
    raise ValueError("SEARCH_TERM bos olamaz.")

flags = 0 if CASE_SENSITIVE else re.IGNORECASE

try:
    PATTERN = re.compile(
        SEARCH_TERM if REGEX_MODE else re.escape(SEARCH_TERM),
        flags
    )
except re.error as exc:
    raise ValueError("Arama deseni gecersiz: {}".format(exc))

