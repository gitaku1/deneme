        code_notebooks = project.list_jupyter_notebooks(
            as_type="objects"
        )
    except Exception as exc:
        code_notebooks = []
        record_error(
            project_key, project_name, "",
            "Code Notebook", "list_jupyter_notebooks", exc
        )

    code_notebook_count = len(code_notebooks)

    for notebook in code_notebooks:
        name = (
            getattr(notebook, "notebook_name", None)
            or getattr(notebook, "name", None)
            or "unknown_notebook"
        )

        try:
            scan_python_notebook(
                project_key, project_name, notebook
            )
            code_notebook_success += 1

        except Exception as exc:
            code_notebook_failed += 1

            record_error(
                project_key, project_name, str(name),
                "Code Notebook",
                "get_content/get_cells",
                exc
            )

    # ------------------------------------------------------------
    # 3C. SQL NOTEBOOK TARAMASI
    # ------------------------------------------------------------

    try:
        sql_notebooks = project.list_sql_notebooks(
            as_type="objects"
        )
    except Exception as exc:
        sql_notebooks = []
        record_error(
            project_key, project_name, "",
            "SQL Notebook", "list_sql_notebooks", exc
        )

    sql_notebook_count = len(sql_notebooks)

    for notebook in sql_notebooks:
        name = (
            getattr(notebook, "id", None)
            or getattr(notebook, "notebook_id", None)
            or "unknown_sql_notebook"
        )

        try:
            scan_sql_notebook(
                project_key, project_name, notebook
            )
            sql_notebook_success += 1

        except Exception as exc:
            sql_notebook_failed += 1

            record_error(
                project_key, project_name, str(name),
                "SQL Notebook",
                "get_content/cells",
                exc
            )

    # ------------------------------------------------------------
    # 3D. PROJE OZETI
    # ------------------------------------------------------------

    project_match_count = len(matches) - project_match_start
    project_error_count = len(errors) - project_error_start

    if project_error_count == 0:
        status = "TAMAMLANDI"
    elif (
        recipe_success + code_notebook_success
        + sql_notebook_success
    ) > 0:
        status = "KISMEN TAMAMLANDI"
    else:
        status = "HATA"

    project_reports.append({
        "project_key": project_key,
        "project_name": project_name,
        "recipes": recipe_count,
        "recipes_read": recipe_success,
        "recipes_failed": recipe_failed,
        "code_notebooks": code_notebook_count,
        "code_notebooks_read": code_notebook_success,
