#!/usr/bin/env python3

import subprocess
import datetime
import os
import sys

# ============================================================
# CONFIGURATION
# ============================================================

KUBECONFIG = "/home/dataiku/.kube/namespace"

NAMESPACE = "dataiku-prod"

# Write the beginning of the target pod name here.
# Example:
# dataiku-exec-prediction-scoring-
POD_PREFIX = "TEST-POD-PREFIX-"

# Write the target PID here.
TARGET_PID = "86"

# ============================================================
# ENVIRONMENT
# ============================================================

os.environ["KUBECONFIG"] = KUBECONFIG
os.environ["PATH"] = (
    f"/veri1/kubeconf:{os.environ.get('PATH', '')}"
)

os.environ["http_proxy"] = ""
os.environ["https_proxy"] = ""
os.environ["HTTP_PROXY"] = ""
os.environ["HTTPS_PROXY"] = ""
os.environ["no_proxy"] = ""
os.environ["NO_PROXY"] = ""


# ============================================================
# LOG FUNCTION
# ============================================================

def log(message):
    timestamp = datetime.datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    print(
        f"[{timestamp}] {message}",
        flush=True
    )


# ============================================================
# RUN COMMAND
# ============================================================

def run_command(cmd):

    try:

        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        return result

    except Exception as e:

        log(
            f"COMMAND EXCEPTION: "
            f"{type(e).__name__}: {e}"
        )

        return None


# ============================================================
# MAIN
# ============================================================

def check_pods():

    log("==================================================")
    log("TEST POD WATCHDOG STARTED")
    log("==================================================")

    log(f"KUBECONFIG = {KUBECONFIG}")
    log(f"NAMESPACE  = {NAMESPACE}")
    log(f"POD_PREFIX = {POD_PREFIX}")
    log(f"TARGET_PID = {TARGET_PID}")

    # --------------------------------------------------------
    # STEP 1 - TEST KUBECTL ACCESS
    # --------------------------------------------------------

    log("STEP 1: Testing Kubernetes access")

    test_cmd = [
        "kubectl",
        "--kubeconfig",
        KUBECONFIG,
        "-n",
        NAMESPACE,
        "get",
        "pods"
    ]

    test_result = run_command(test_cmd)

    if test_result is None:

        log("ERROR: Could not execute kubectl")
        return

    if test_result.returncode != 0:

        log("ERROR: Kubernetes access failed")

        log(
            f"STDERR: "
            f"{test_result.stderr.strip()}"
        )

        return

    log("Kubernetes access successful")


    # --------------------------------------------------------
    # STEP 2 - GET ALL PODS
    # --------------------------------------------------------

    log(
        f"STEP 2: Getting all pods from namespace "
        f"{NAMESPACE}"
    )

    pods_cmd = [
        "kubectl",
        "--kubeconfig",
        KUBECONFIG,
        "-n",
        NAMESPACE,
        "get",
        "pods",
        "-o",
        "custom-columns=NAME:.metadata.name,STATUS:.status.phase,START:.metadata.creationTimestamp",
        "--no-headers"
    ]

    pods_result = run_command(pods_cmd)

    if pods_result is None:

        log("ERROR: Could not get pod list")
        return

    if pods_result.returncode != 0:

        log("ERROR: kubectl get pods failed")

        log(
            f"STDERR: "
            f"{pods_result.stderr.strip()}"
        )

        return


    output = pods_result.stdout.strip()

    if not output:

        log(
            f"No pods found in namespace {NAMESPACE}"
        )

        return


    # --------------------------------------------------------
    # STEP 3 - PRINT ALL PODS
    # --------------------------------------------------------

    log("--------------------------------------------------")
    log("ALL PODS IN TARGET NAMESPACE")
    log("--------------------------------------------------")

    all_pod_names = []

    for line in output.splitlines():

        parts = line.split()

        if len(parts) < 1:
            continue

        pod_name = parts[0]

        all_pod_names.append(pod_name)

        log(f"POD FOUND: {line}")


    log("--------------------------------------------------")
    log(
        f"TOTAL PODS FOUND: "
        f"{len(all_pod_names)}"
    )
    log("--------------------------------------------------")


    # --------------------------------------------------------
    # STEP 4 - PREFIX MATCH
    # --------------------------------------------------------

    log(
        f"STEP 4: Searching pods with prefix: "
        f"{POD_PREFIX}"
    )

    matching_pods = []

    for line in output.splitlines():

        parts = line.split()

        if len(parts) < 3:
            continue

        pod_name = parts[0]
        pod_status = parts[1]
        creation_time_str = parts[2]

        if pod_name.startswith(POD_PREFIX):

            matching_pods.append(
                (
                    pod_name,
                    pod_status,
                    creation_time_str
                )
            )


    if not matching_pods:

        log("NO MATCHING POD FOUND")

        log(
            "CHECK POD_PREFIX VALUE ABOVE"
        )

        log("AVAILABLE POD NAMES:")

        for pod in all_pod_names:

            log(f"  {pod}")

        return


    log(
        f"MATCHING POD COUNT: "
        f"{len(matching_pods)}"
    )


    # --------------------------------------------------------
    # STEP 5 - ANALYZE MATCHING PODS
    # --------------------------------------------------------

    for (
        pod_name,
        pod_status,
        creation_time_str
    ) in matching_pods:

        log("==================================================")
        log(f"MATCHING POD: {pod_name}")
        log(f"STATUS: {pod_status}")
        log(f"CREATION TIME: {creation_time_str}")


        # ----------------------------------------------------
        # CALCULATE POD AGE
        # ----------------------------------------------------

        try:

            creation_time = (
                datetime.datetime.fromisoformat(
                    creation_time_str.replace(
                        "Z",
                        "+00:00"
                    )
                )
            )

            now = datetime.datetime.now(
                datetime.timezone.utc
            )

            duration_minutes = (
                now - creation_time
            ).total_seconds() / 60

            log(
                f"AGE MINUTES: "
                f"{duration_minutes:.2f}"
            )

        except Exception as e:

            log(
                f"AGE CALCULATION ERROR: {e}"
            )


        # ----------------------------------------------------
        # CHECK POD STATUS
        # ----------------------------------------------------

        if pod_status.upper() != "RUNNING":

            log(
                "POD IS NOT RUNNING"
            )

            log(
                "PID CHECK WILL BE SKIPPED"
            )

            continue


        log(
            "POD IS RUNNING"
        )


        # ----------------------------------------------------
        # STEP 6 - EXEC TEST
        # ----------------------------------------------------

        log(
            "Testing kubectl exec"
        )

        exec_cmd = [
            "kubectl",
            "--kubeconfig",
            KUBECONFIG,
            "-n",
            NAMESPACE,
            "exec",
            pod_name,
            "--",
            "sh",
            "-c",
            "echo EXEC_TEST_SUCCESS"
        ]

        exec_result = run_command(
            exec_cmd
        )

        if exec_result is None:

            log(
                "ERROR: EXEC COMMAND COULD NOT START"
            )

            continue


        if exec_result.returncode != 0:

            log(
                "ERROR: KUBECTL EXEC FAILED"
            )

            log(
                f"STDERR: "
                f"{exec_result.stderr.strip()}"
            )

            continue


        log(
            "KUBECTL EXEC SUCCESS"
        )

        if exec_result.stdout.strip():

            log(
                f"EXEC OUTPUT: "
                f"{exec_result.stdout.strip()}"
            )


        # ----------------------------------------------------
        # STEP 7 - PID CHECK
        # ----------------------------------------------------

        log(
            f"Checking PID {TARGET_PID}"
        )

        pid_cmd = [
            "kubectl",
            "--kubeconfig",
            KUBECONFIG,
            "-n",
            NAMESPACE,
            "exec",
            pod_name,
            "--",
            "test",
            "-d",
            f"/proc/{TARGET_PID}"
        ]

        pid_result = run_command(
            pid_cmd
        )

        if pid_result is None:

            log(
                "ERROR: PID CHECK COMMAND FAILED"
            )

            continue


        if pid_result.returncode != 0:

            log(
                f"PID {TARGET_PID} NOT FOUND"
            )

            if pid_result.stderr.strip():

                log(
                    f"PID CHECK STDERR: "
                    f"{pid_result.stderr.strip()}"
                )

            continue


        log(
            f"PID {TARGET_PID} FOUND"
        )


        # ----------------------------------------------------
        # STEP 8 - PROCESS INFO
        # ----------------------------------------------------

        ps_cmd = [
            "kubectl",
            "--kubeconfig",
            KUBECONFIG,
            "-n",
            NAMESPACE,
            "exec",
            pod_name,
            "--",
            "ps",
            "-p",
            TARGET_PID,
            "-o",
            "pid,ppid,stat,etime,wchan:30,cmd"
        ]

        ps_result = run_command(
            ps_cmd
        )

        if (
            ps_result is not None
            and ps_result.returncode == 0
        ):

            log(
                f"PROCESS INFO FOR PID "
                f"{TARGET_PID}:"
            )

            for ps_line in (
                ps_result.stdout.strip().splitlines()
            ):

                log(
                    f"  {ps_line}"
                )

        else:

            log(
                "PROCESS INFO COMMAND FAILED"
            )


        # ----------------------------------------------------
        # STEP 9 - WCHAN
        # ----------------------------------------------------

        wchan_cmd = [
            "kubectl",
            "--kubeconfig",
            KUBECONFIG,
            "-n",
            NAMESPACE,
            "exec",
            pod_name,
            "--",
            "cat",
            f"/proc/{TARGET_PID}/wchan"
        ]

        wchan_result = run_command(
            wchan_cmd
        )

        if (
            wchan_result is not None
            and wchan_result.returncode == 0
        ):

            log(
                f"WCHAN: "
                f"{wchan_result.stdout.strip()}"
            )

        else:

            log(
                "WCHAN CHECK FAILED"
            )


        # ----------------------------------------------------
        # NO ACTION
        # ----------------------------------------------------

        log(
            "TEST COMPLETE"
        )

        log(
            "NO GDB EXECUTED"
        )

        log(
            "NO PROCESS TERMINATED"
        )

        log(
            "NO POD DELETED"
        )


    log("==================================================")
    log("TEST POD WATCHDOG FINISHED")
    log("==================================================")


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":

    check_pods()








#!/usr/bin/env python3

import subprocess
import datetime
import os

# ============================================================
# ENVIRONMENT
# ============================================================

os.environ["KUBECONFIG"] = "/home/dataiku/.kube/namespace"
os.environ["PATH"] = f"/veri1/kubeconf:{os.environ.get('PATH', '')}"

# Disable proxies
os.environ["http_proxy"] = ""
os.environ["https_proxy"] = ""
os.environ["no_proxy"] = ""


# ============================================================
# CONFIGURATION
# ============================================================

# Target Kubernetes Namespace
NAMESPACE = "dataiku-prod"

# Target Pod prefix
POD_PREFIX = "dataiku-exec-prediction-scoring-"

# Maximum allowed duration in minutes (230 min = 3 hours 50 min)
MAX_ALLOWED_MINUTES = 230

# Dataiku recipe process PID inside container
TARGET_PID = "86"


# ============================================================
# LOGGING
# ============================================================

def log(message):
    print(
        f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
        f"{message}",
        flush=True
    )


# ============================================================
# MAIN
# ============================================================

def check_and_exit_job():

    log("Dataiku stuck-job watchdog started.")

    # --------------------------------------------------------
    # 1. Test Kubernetes Connection
    # --------------------------------------------------------

    try:
        kubectl_version = subprocess.run(
            [
                "kubectl",
                "version",
                "--client",
                "--output=yaml"
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if kubectl_version.returncode != 0:
            log("ERROR: kubectl execution failed. Check cluster connection or config.")
            if kubectl_version.stderr:
                log(f"kubectl stderr: {kubectl_version.stderr}")
            return

    except Exception as e:
        log(f"ERROR: Could not launch kubectl: {type(e).__name__}: {e}")
        return

    # --------------------------------------------------------
    # 2. Retrieve Pod List in Namespace
    # --------------------------------------------------------

    cmd = [
        "kubectl",
        "get",
        "pods",
        "-n",
        NAMESPACE,
        "--no-headers",
        "-o",
        "custom-columns=NAME:.metadata.name,STATUS:.status.phase,START:.metadata.creationTimestamp"
    ]

    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
    except Exception as e:
        log(f"ERROR: kubectl get pods command failed: {type(e).__name__}: {e}")
        return

    if result.returncode != 0:
        log(
            f"ERROR: Could not fetch pods from namespace '{NAMESPACE}'. "
            f"This will not be evaluated as PID missing."
        )
        if result.stderr:
            log(f"kubectl stderr: {result.stderr}")
        return

    output = result.stdout
    found_target_pod = False

    # --------------------------------------------------------
    # 3. Process Pods
    # --------------------------------------------------------

    for line in output.strip().splitlines():

        if not line.strip():
            continue

        parts = line.split()

        if len(parts) < 3:
            continue

        pod_name = parts[0]
        pod_status = parts[1]
        creation_time_str = parts[2]

        # Filter by Pod Prefix and RUNNING status
        if not pod_name.startswith(POD_PREFIX):
            continue

        if pod_status.upper() != "RUNNING":
            continue

        found_target_pod = True

        # Calculate Pod Age
        try:
            creation_time = datetime.datetime.fromisoformat(
                creation_time_str.replace("Z", "+00:00")
            )
        except Exception as e:
            log(f"{pod_name}: Could not parse creationTimestamp: {e}")
            continue

        now = datetime.datetime.now(datetime.timezone.utc)
        duration_minutes = (now - creation_time).total_seconds() / 60.0

        log(
            f"Target pod found: {pod_name} | "
            f"Status={pod_status} | "
            f"Duration={duration_minutes:.1f} minutes"
        )

        # Skip if duration limit is not reached
        if duration_minutes < MAX_ALLOWED_MINUTES:
            log(
                f"{pod_name}: Duration limit not exceeded "
                f"({duration_minutes:.1f} < {MAX_ALLOWED_MINUTES} min). "
                f"No action taken."
            )
            continue

        # ====================================================
        # DURATION EXCEEDED
        # ====================================================

        log(
            f"{pod_name}: Duration limit exceeded. "
            f"Checking PID {TARGET_PID}..."
        )

        # ----------------------------------------------------
        # 4. Check kubectl exec connectivity
        # ----------------------------------------------------

        exec_test_cmd = [
            "kubectl",
            "exec",
            "-n",
            NAMESPACE,
            pod_name,
            "--",
            "sh",
            "-c",
            "echo DATAIKU_EXEC_OK"
        ]

        exec_test = subprocess.run(
            exec_test_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if exec_test.returncode != 0:
            log(
                f"ERROR: kubectl exec failed for {pod_name}. "
                f"This does NOT mean PID {TARGET_PID} is missing."
            )
            if exec_test.stderr:
                log(f"{pod_name} exec stderr: {exec_test.stderr}")
            continue

        log(f"{pod_name}: kubectl exec connection successful.")

        # ----------------------------------------------------
        # 5. Check if TARGET_PID exists
        # ----------------------------------------------------

        pid_check_cmd = [
            "kubectl",
            "exec",
            "-n",
            NAMESPACE,
            pod_name,
            "--",
            "test",
            "-d",
            f"/proc/{TARGET_PID}"
        ]

        pid_check = subprocess.run(
            pid_check_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if pid_check.returncode != 0:
            log(
                f"{pod_name}: PID {TARGET_PID} not found in container. "
                f"GDB step skipped."
            )
            continue

        log(f"{pod_name}: PID {TARGET_PID} exists.")

        # ====================================================
        # 6. EXECUTE GDB EXIT(0)
        # ====================================================

        log(f"{pod_name}: Attaching GDB to PID {TARGET_PID}...")

        gdb_cmd = [
            "kubectl",
            "exec",
            "-n",
            NAMESPACE,
            pod_name,
            "--",
            "gdb",
            "-q",
            "-n",
            "-batch",
            "-p",
            TARGET_PID,
            "-ex",
            "call (void)_exit(0)"
        ]

        gdb_result = subprocess.run(
            gdb_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True
        )

        log(f"{pod_name}: GDB return code = {gdb_result.returncode}")

        if gdb_result.stdout:
            log(f"{pod_name}: GDB output:\n{gdb_result.stdout}")

        if gdb_result.returncode == 0:
            log(f"{pod_name}: GDB _exit(0) successfully executed.")
            log(f"{pod_name}: Waiting for Dataiku runner to handle container exit.")
        else:
            log(f"ERROR: GDB execution failed for {pod_name}.")

    # --------------------------------------------------------
    # 7. No Matching Pod Found
    # --------------------------------------------------------

    if not found_target_pod:
        log(
            f"No matching running pod found in namespace '{NAMESPACE}' "
            f"with prefix '{POD_PREFIX}'."
        )


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    check_and_exit_job()















