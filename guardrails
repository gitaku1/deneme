#!/usr/bin/env python3

import subprocess
import datetime
import os

# ============================================================
# ENVIRONMENT
# ============================================================

os.environ["KUBECONFIG"] = "/home/dataiku/.kube/namespace"
os.environ["PATH"] = f"/veri1/kubeconf:{os.environ.get('PATH', '')}"

os.environ["http_proxy"] = ""
os.environ["https_proxy"] = ""
os.environ["no_proxy"] = ""


# ============================================================
# TEST CONFIGURATION
# ============================================================

# TEST POD PREFIX'INI BURAYA YAZ
POD_PREFIX = "TEST-POD-PREFIX-"

# TEST PODUNDA KONTROL ETMEK İSTEDİĞİN PID
TARGET_PID = "86"

# Sadece bilgi amaçlı eşik
MAX_ALLOWED_MINUTES = 230


# ============================================================
# LOG
# ============================================================

def log(message):
    print(
        f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
        f"{message}",
        flush=True
    )


# ============================================================
# TEST
# ============================================================

def check_test_pods():

    log("==============================================")
    log("TEST POD WATCHDOG BAŞLADI")
    log("==============================================")

    log(f"KUBECONFIG : {os.environ['KUBECONFIG']}")
    log(f"POD PREFIX : {POD_PREFIX}")
    log(f"TARGET PID : {TARGET_PID}")
    log(f"TIMEOUT    : {MAX_ALLOWED_MINUTES} dakika")

    # --------------------------------------------------------
    # 1. kubectl get pods
    # --------------------------------------------------------

    cmd = [
        "kubectl",
        "get",
        "pods",
        "--no-headers",
        "-o",
        "custom-columns=NAME:.metadata.name,STATUS:.status.phase,START:.metadata.creationTimestamp"
    ]

    log("Kubernetes pod listesi alınıyor...")

    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    if result.returncode != 0:

        log("❌ kubectl get pods BAŞARISIZ")

        if result.stderr:
            log(f"kubectl stderr: {result.stderr}")

        return

    log("✅ kubectl get pods başarılı")

    found = False


    # --------------------------------------------------------
    # 2. Podları incele
    # --------------------------------------------------------

    for line in result.stdout.strip().splitlines():

        if not line.strip():
            continue

        parts = line.split()

        if len(parts) < 3:
            continue

        pod_name = parts[0]
        pod_status = parts[1]
        creation_time_str = parts[2]


        # Sadece test pod prefix
        if not pod_name.startswith(POD_PREFIX):
            continue


        found = True

        log("----------------------------------------------")
        log(f"TEST POD BULUNDU : {pod_name}")
        log(f"STATUS            : {pod_status}")
        log(f"CREATION TIME     : {creation_time_str}")


        # ----------------------------------------------------
        # Pod yaşı
        # ----------------------------------------------------

        try:

            creation_time = datetime.datetime.fromisoformat(
                creation_time_str.replace("Z", "+00:00")
            )

            now = datetime.datetime.now(datetime.timezone.utc)

            duration_minutes = (
                now - creation_time
            ).total_seconds() / 60.0

            log(
                f"ÇALIŞMA SÜRESİ    : "
                f"{duration_minutes:.1f} dakika"
            )

        except Exception as e:

            log(f"⚠️ Creation time hesaplanamadı: {e}")
            duration_minutes = -1


        # ----------------------------------------------------
        # Sadece RUNNING ise exec testi yap
        # ----------------------------------------------------

        if pod_status.upper() != "RUNNING":

            log(
                f"Pod RUNNING değil ({pod_status}). "
                f"Exec/PID testi yapılmayacak."
            )

            continue


        # ----------------------------------------------------
        # 3. kubectl exec bağlantı testi
        # ----------------------------------------------------

        log("kubectl exec bağlantısı test ediliyor...")

        exec_test_cmd = [
            "kubectl",
            "exec",
            pod_name,
            "--",
            "sh",
            "-c",
            "echo DATAIKU_WATCHDOG_EXEC_OK"
        ]

        exec_test = subprocess.run(
            exec_test_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if exec_test.returncode != 0:

            log("❌ kubectl exec BAŞARISIZ")

            if exec_test.stderr:
                log(
                    f"kubectl exec stderr: "
                    f"{exec_test.stderr}"
                )

            continue


        log("✅ kubectl exec BAŞARILI")

        if exec_test.stdout:
            log(
                f"Exec output: "
                f"{exec_test.stdout.strip()}"
            )


        # ----------------------------------------------------
        # 4. PID kontrolü
        # ----------------------------------------------------

        log(
            f"PID {TARGET_PID} kontrol ediliyor..."
        )

        pid_check_cmd = [
            "kubectl",
            "exec",
            pod_name,
            "--",
            "test",
            "-d",
            f"/proc/{TARGET_PID}"
        ]

        pid_check = subprocess.run(
            pid_check_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )


        if pid_check.returncode == 0:

            log(
                f"✅ PID {TARGET_PID} mevcut"
            )

            # ------------------------------------------------
            # PID bilgilerini sadece OKU
            # ------------------------------------------------

            ps_cmd = [
                "kubectl",
                "exec",
                pod_name,
                "--",
                "ps",
                "-p",
                TARGET_PID,
                "-o",
                "pid,ppid,stat,etime,wchan:30,cmd"
            ]

            ps_result = subprocess.run(
                ps_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )

            if ps_result.returncode == 0:

                log(
                    f"PID {TARGET_PID} bilgisi:"
                )

                for ps_line in ps_result.stdout.strip().splitlines():
                    log(f"    {ps_line}")

            else:

                log(
                    f"⚠️ PID {TARGET_PID} mevcut fakat "
                    f"ps bilgisi alınamadı."
                )

                if ps_result.stderr:
                    log(
                        f"ps stderr: "
                        f"{ps_result.stderr}"
                    )


        else:

            log(
                f"ℹ️ PID {TARGET_PID} mevcut değil."
            )


        # ----------------------------------------------------
        # 5. /proc status bilgisi
        # ----------------------------------------------------

        if pid_check.returncode == 0:

            status_cmd = [
                "kubectl",
                "exec",
                pod_name,
                "--",
                "sh",
                "-c",
                f"cat /proc/{TARGET_PID}/status | "
                f"grep -E 'State|Threads|VmRSS'"
            ]

            status_result = subprocess.run(
                status_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )

            if status_result.returncode == 0:

                log(
                    f"/proc/{TARGET_PID}/status:"
                )

                for status_line in status_result.stdout.strip().splitlines():
                    log(f"    {status_line}")


        # ----------------------------------------------------
        # 6. WCHAN bilgisi
        # ----------------------------------------------------

        if pid_check.returncode == 0:

            wchan_cmd = [
                "kubectl",
                "exec",
                pod_name,
                "--",
                "cat",
                f"/proc/{TARGET_PID}/wchan"
            ]

            wchan_result = subprocess.run(
                wchan_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )

            if wchan_result.returncode == 0:

                log(
                    f"WCHAN PID {TARGET_PID}: "
                    f"{wchan_result.stdout.strip()}"
                )


        # ----------------------------------------------------
        # ÖNEMLİ:
        # BURADA HİÇBİR KILL / GDB / DELETE YOK
        # ----------------------------------------------------

        log(
            f"✅ {pod_name} analiz edildi. "
            f"HERHANGİ BİR PROCESS'E MÜDAHALE EDİLMEDİ."
        )


    # --------------------------------------------------------
    # Pod bulunamadı
    # --------------------------------------------------------

    if not found:

        log(
            f"⚠️ '{POD_PREFIX}*' prefix'ine sahip "
            f"pod bulunamadı."
        )


    log("==============================================")
    log("TEST POD WATCHDOG BİTTİ")
    log("==============================================")


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    check_test_pods()






























#!/usr/bin/env python3

import subprocess
import datetime
import os

# ============================================================
# TEST KONFİGÜRASYONU (İhtiyacınıza Göre Düzenleyin)
# ============================================================

# Test etmek istediğiniz pod adının prefix'i veya tam adı
POD_PREFIX = "test-pod-prefix-"  

# Test etmek istediğiniz pod içindeki hedef PID (Örn: 1234, 1, vb.)
TARGET_PID = "86"

# Test kolaylığı için eşik süresi (dakika cinsinden)
MAX_ALLOWED_MINUTES = 230


# ============================================================
# ENVIRONMENT
# ============================================================

os.environ["KUBECONFIG"] = "/home/dataiku/.kube/namespace"
os.environ["PATH"] = f"/veri1/kubeconf:{os.environ.get('PATH', '')}"

# Proxy temizleme
os.environ["http_proxy"] = ""
os.environ["https_proxy"] = ""
os.environ["no_proxy"] = ""


# ============================================================
# LOG
# ============================================================

def log(message):
    print(
        f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
        f"{message}",
        flush=True
    )


# ============================================================
# MAIN (DRY-RUN / SADECE LOG)
# ============================================================

def check_and_exit_job_dry_run():

    log("Dataiku stuck-job watchdog [DRY-RUN MODU] başlatıldı.")

    # --------------------------------------------------------
    # 1. Kubernetes bağlantısını test et
    # --------------------------------------------------------

    try:
        kubectl_version = subprocess.run(
            [
                "kubectl",
                "version",
                "--client",
                "--output=yaml"
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if kubectl_version.returncode != 0:
            log(
                "HATA: kubectl çalıştırılamadı. "
                "Kubernetes bağlantısı/konfigürasyonu kontrol edilmeli."
            )
            if kubectl_version.stderr:
                log(f"kubectl stderr: {kubectl_version.stderr}")
            return

    except Exception as e:
        log(
            f"HATA: kubectl başlatılamadı: "
            f"{type(e).__name__}: {e}"
        )
        return

    # --------------------------------------------------------
    # 2. Pod listesini al
    # --------------------------------------------------------

    cmd = [
        "kubectl",
        "get",
        "pods",
        "--no-headers",
        "-o",
        "custom-columns=NAME:.metadata.name,STATUS:.status.phase,START:.metadata.creationTimestamp"
    ]

    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
    except Exception as e:
        log(
            f"HATA: kubectl get pods çalıştırılamadı: "
            f"{type(e).__name__}: {e}"
        )
        return

    if result.returncode != 0:
        log(
            "HATA: Kubernetes pod listesi alınamadı. "
            "Bu durum PID bulunamadı olarak yorumlanmayacak."
        )
        if result.stderr:
            log(f"kubectl stderr: {result.stderr}")
        return

    output = result.stdout
    found_target_pod = False

    # --------------------------------------------------------
    # 3. Podları incele
    # --------------------------------------------------------

    for line in output.strip().splitlines():

        if not line.strip():
            continue

        parts = line.split()

        if len(parts) < 3:
            continue

        pod_name = parts[0]
        pod_status = parts[1]
        creation_time_str = parts[2]

        # ----------------------------------------------------
        # Sadece hedef test podları
        # ----------------------------------------------------

        if not pod_name.startswith(POD_PREFIX):
            continue

        if pod_status.upper() != "RUNNING":
            continue

        found_target_pod = True

        # ----------------------------------------------------
        # Pod yaşını hesapla
        # ----------------------------------------------------

        try:
            creation_time = datetime.datetime.fromisoformat(
                creation_time_str.replace("Z", "+00:00")
            )
        except Exception as e:
            log(
                f"{pod_name}: creationTimestamp parse edilemedi: {e}"
            )
            continue

        now = datetime.datetime.now(datetime.timezone.utc)

        duration_minutes = (
            now - creation_time
        ).total_seconds() / 60.0

        log(
            f"Hedef pod bulundu: {pod_name} | "
            f"Durum={pod_status} | "
            f"Süre={duration_minutes:.1f} dakika"
        )

        # ----------------------------------------------------
        # Eşik dolmadıysa müdahale edilmiyor
        # ----------------------------------------------------

        if duration_minutes < MAX_ALLOWED_MINUTES:
            log(
                f"{pod_name}: "
                f"{duration_minutes:.1f} < "
                f"{MAX_ALLOWED_MINUTES} dakika. "
                f"[DRY-RUN] Müdahale edilmiyor."
            )
            continue

        # ====================================================
        # EŞİK AŞILDI
        # ====================================================

        log(
            f"{pod_name}: Süre eşiği aşıldı. "
            f"PID {TARGET_PID} kontrol ediliyor."
        )

        # ----------------------------------------------------
        # 4. Önce kubectl exec bağlantısını doğrula
        # ----------------------------------------------------

        exec_test_cmd = [
            "kubectl",
            "exec",
            pod_name,
            "--",
            "sh",
            "-c",
            "echo DATAIKU_EXEC_OK"
        ]

        exec_test = subprocess.run(
            exec_test_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if exec_test.returncode != 0:
            log(
                f"HATA: {pod_name} için kubectl exec başarısız. "
                f"Bu durum PID {TARGET_PID} yok anlamına GELMEZ."
            )
            if exec_test.stderr:
                log(
                    f"{pod_name} kubectl exec stderr: "
                    f"{exec_test.stderr}"
                )
            continue

        log(
            f"{pod_name}: kubectl exec bağlantısı başarılı."
        )

        # ----------------------------------------------------
        # 5. PID gerçekten var mı?
        # ----------------------------------------------------

        pid_check_cmd = [
            "kubectl",
            "exec",
            pod_name,
            "--",
            "test",
            "-d",
            f"/proc/{TARGET_PID}"
        ]

        pid_check = subprocess.run(
            pid_check_cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if pid_check.returncode != 0:
            log(
                f"{pod_name}: PID {TARGET_PID} bulunamadı. "
                f"[DRY-RUN] GDB çalıştırılması simüle edilmeyecek."
            )
            continue

        log(
            f"{pod_name}: PID {TARGET_PID} mevcut."
        )

        # ====================================================
        # 6. SIMÜLE EDİLEN GDB ADIMI (DRY-RUN)
        # ====================================================

        log(
            f"[DRY-RUN SIMÜLASYON]: {pod_name} içerisinde PID {TARGET_PID} bulundu. "
            f"Gerçek çalışmada şu komut tetiklenecekti:\n"
            f"-> kubectl exec {pod_name} -- gdb -q -n -batch -p {TARGET_PID} -ex 'call (void)_exit(0)'"
        )

        log(
            f"[DRY-RUN SIMÜLASYON]: GDB müdahalesi başarıyla simüle edildi. "
            f"Gerçek bir müdahale yapılmadı."
        )

    # --------------------------------------------------------
    # 7. Hedef pod yoksa
    # --------------------------------------------------------

    if not found_target_pod:
        log(
            f"Aktif hedef pod bulunamadı. "
            f"Prefix={POD_PREFIX}, Status=RUNNING"
        )


if __name__ == "__main__":
    check_and_exit_job_dry_run()
