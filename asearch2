const $ = (id) => document.getElementById(id);

let lastResults = [];
let lastErrors = [];
let lastProjects = [];

function setStatus(message, type = "") {
  const el = $("status");
  el.textContent = message;
  el.className = "status" + (type ? " " + type : "");
}

function makeCell(value, className = "") {
  const td = document.createElement("td");
  td.textContent = value == null ? "" : String(value);
  if (className) td.className = className;
  return td;
}

function renderTable(bodyId, rows, columns, emptyMessage) {
  const body = $(bodyId);
  body.replaceChildren();

  if (!rows || rows.length === 0) {
    const tr = document.createElement("tr");
    const td = makeCell(emptyMessage);
    td.colSpan = columns.length;
    td.className = "empty";
    tr.appendChild(td);
    body.appendChild(tr);
    return;
  }

  rows.forEach(row => {
    const tr = document.createElement("tr");

    columns.forEach(col => {
      let value = row[col.key];

      if (col.key === "status") {
        const td = document.createElement("td");
        const pill = document.createElement("span");
        pill.className = "status-pill";

        if (String(value).includes("HATA")) {
          pill.classList.add("bad");
        } else if (String(value).includes("KISMEN")) {
          pill.classList.add("warn");
        }

        pill.textContent = value || "";
        td.appendChild(pill);
        tr.appendChild(td);
      } else {
        tr.appendChild(makeCell(value, col.code ? "code" : ""));
      }
    });

    body.appendChild(tr);
  });
}

const resultColumns = [
  {key: "project_key"},
  {key: "object_name"},
  {key: "object_type"},
  {key: "source"},
  {key: "line_number"},
  {key: "matched_text", code: true},
  {key: "context", code: true}
];

const projectColumns = [
  {key: "project_key"},
  {key: "recipes"},
  {key: "recipes_read"},
  {key: "recipes_failed"},
  {key: "code_notebooks"},
  {key: "sql_notebooks"},
  {key: "matches"},
  {key: "status"}
];

const errorColumns = [
  {key: "project_key"},
  {key: "object_name"},
  {key: "object_type"},
  {key: "stage"},
  {key: "error_category"},
  {key: "error"},
  {key: "suggestion"}
];

async function runSearch() {
  const term = $("searchTerm").value.trim();

  if (!term) {
    setStatus("Lütfen aranacak bir terim girin.", "error");
    return;
  }

  $("searchButton").disabled = true;
  $("exportButton").disabled = true;

  setStatus(
    "Arama başladı. Projeler, recipe'ler ve notebook'lar taranıyor. " +
    "Proje sayısına göre biraz sürebilir."
  );

  try {
    const url = getWebAppBackendUrl("api/search");

    const response = await fetch(url, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({
        term: term,
        case_sensitive: $("caseSensitive").checked,
        search_names: $("searchNames").checked
      })
    });

    const payload = await response.json();

    if (!response.ok || !payload.ok) {
      throw new Error(payload.error || "Arama isteği başarısız oldu.");
    }

    lastResults = payload.results || [];
    lastErrors = payload.errors || [];
    lastProjects = payload.projects || [];

    $("projectCount").textContent = payload.summary.projects ?? 0;
    $("recipeCount").textContent =
      `${payload.summary.recipes_read ?? 0}/${payload.summary.recipes ?? 0}`;
    $("notebookCount").textContent =
      `${payload.summary.notebooks_read ?? 0}/${payload.summary.notebooks ?? 0}`;
    $("matchCount").textContent = payload.summary.matches ?? 0;
    $("errorCount").textContent = payload.summary.errors ?? 0;

    renderTable(
      "resultsBody", lastResults, resultColumns,
      "Bu terim için eşleşme bulunamadı."
    );

    renderTable(
      "projectsBody", lastProjects, projectColumns,
      "Proje raporu bulunamadı."
    );

    renderTable(
      "errorsBody", lastErrors, errorColumns,
      "Tarama sırasında hata oluşmadı."
    );

    $("exportButton").disabled = lastResults.length === 0;

    const duration = Number(payload.summary.duration_seconds || 0);
    const errorCount = Number(payload.summary.errors || 0);

    setStatus(
      `Arama tamamlandı: ${payload.summary.matches} eşleşme, ` +
      `${errorCount} hata, ${duration.toFixed(1)} saniye.`,
      errorCount > 0 ? "" : "success"
    );

  } catch (err) {
    setStatus("Arama başarısız: " + err.message, "error");
  } finally {
    $("searchButton").disabled = false;
  }
}

function exportCsv() {
  if (!lastResults.length) return;

  const columns = [
    "project_key", "project_name", "object_name",
    "object_type", "source", "line_number",
    "matched_text", "line_text", "context"
  ];

  const quote = value =>
    '"' + String(value ?? "").replace(/"/g, '""') + '"';

  const csv = [
    columns.join(","),
    ...lastResults.map(row =>
      columns.map(col => quote(row[col])).join(",")
    )
  ].join("\r\n");

  const blob = new Blob(["\uFEFF" + csv], {
    type: "text/csv;charset=utf-8;"
  });

  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "dataiku_global_search_results.csv";
  a.click();
  URL.revokeObjectURL(url);
}

$("searchButton").addEventListener("click", runSearch);
$("exportButton").addEventListener("click", exportCsv);

$("searchTerm").addEventListener("keydown", event => {
  if (event.key === "Enter") runSearch();
});





















import dataiku
import re
import time
import traceback

from flask import Flask, request, jsonify

app = Flask(__name__)


def text_value(value):
    if value is None:
        return ""
    if isinstance(value, str):
        return value
    return str(value)


def safe_name(obj, *attributes, default="unknown"):
    for attr in attributes:
        try:
            value = getattr(obj, attr, None)
            if value is not None:
                return str(value)
        except Exception:
            pass
    return default


def classify_error(exc):
    message = "{}: {}".format(type(exc).__name__, str(exc))
    lower = message.lower()

    if "403" in lower or "forbidden" in lower or "permission" in lower:
        return "Yetki / erisim engeli"
    if "401" in lower or "unauthorized" in lower:
        return "Kimlik dogrulama"
    if "404" in lower or "not found" in lower:
        return "Nesne bulunamadi"
    if isinstance(exc, (AttributeError, TypeError)):
        return "API / nesne uyumsuzlugu"
    if isinstance(exc, KeyError):
        return "Eksik alan"
    if "timeout" in lower or "timed out" in lower:
        return "Zaman asimi"
    if "connection" in lower:
        return "Baglanti"
    return "Diger hata"


def append_error(errors, project_key, project_name,
                 object_name, object_type, stage, exc):
    message = "{}: {}".format(type(exc).__name__, str(exc))

    errors.append({
        "project_key": project_key,
        "project_name": project_name,
        "object_name": object_name,
        "object_type": object_type,
        "stage": stage,
        "error_category": classify_error(exc),
        "error": message[:2000],
        "suggestion": (
            "Hata asamasini ve gercek API mesajini inceleyin."
        )
    })


def add_matches(results, pattern, term, case_sensitive,
                project_key, project_name, object_name,
                object_type, source, content):
    if content is None:
        return

    if not isinstance(content, str):
        content = str(content)

    for line_number, line in enumerate(content.splitlines(), start=1):
        for found in pattern.finditer(line):
            left = max(0, found.start() - 180)
            right = min(len(line), found.end() + 180)

            results.append({
                "project_key": project_key,
                "project_name": project_name,
                "object_name": object_name,
                "object_type": object_type,
                "source": source,
                "line_number": line_number,
                "matched_text": found.group(0),
                "line_text": line.strip(),
                "context": line[left:right].strip()
            })


def source_to_text(source):
    if isinstance(source, list):
        return "".join(str(part) for part in source)
    if isinstance(source, str):
        return source
    return ""


def get_project_name(project):
    try:
        summary = project.get_summary()
        return (
            summary.get("name")
            or summary.get("projectName")
            or ""
        )
    except Exception:
        return ""


def scan_jupyter_notebook(project, project_key, project_name,
                          item, pattern, term, case_sensitive,
                          search_names, results, errors):
    name = safe_name(
        item, "notebook_name", "name",
        default=str(item)
    )

    if search_names:
        add_matches(
            results, pattern, term, case_sensitive,
            project_key, project_name, name,
            "Code Notebook", "notebook_name", name
        )

    notebook = project.get_jupyter_notebook(name)
    content = notebook.get_content()
    cells = content.get_cells()

    for index, cell in enumerate(cells, start=1):
        if not isinstance(cell, dict):
            continue

        if cell.get("cell_type") != "code":
            continue

        code = source_to_text(cell.get("source", []))

        add_matches(
            results, pattern, term, case_sensitive,
            project_key, project_name, name,
            "Code Notebook", "cell_{}".format(index), code
        )


def scan_sql_notebook(project, project_key, project_name,
                      item, pattern, term, case_sensitive,
                      search_names, results, errors):
    notebook_id = safe_name(
        item, "id", "notebook_id", "name",
        default=str(item)
    )

    if search_names:
        add_matches(
            results, pattern, term, case_sensitive,
            project_key, project_name, notebook_id,
            "SQL Notebook", "notebook_name", notebook_id
        )

    notebook = project.get_sql_notebook(notebook_id)
    content = notebook.get_content()

    cells = getattr(content, "cells", None)

    if cells is None and isinstance(content, dict):
        cells = content.get("cells", [])

    if cells is None:
        raise ValueError(
            "SQL notebook iceriginde cells alani bulunamadi."
        )

    for index, cell in enumerate(cells, start=1):
        if not isinstance(cell, dict):
            continue

        code = cell.get("code", "")

        add_matches(
            results, pattern, term, case_sensitive,
            project_key, project_name, notebook_id,
            "SQL Notebook", "cell_{}".format(index), code
        )


def run_global_search(term, case_sensitive=False, search_names=True):
    started = time.time()

    flags = 0 if case_sensitive else re.IGNORECASE
    pattern = re.compile(re.escape(term), flags)

    client = dataiku.api_client()
    project_keys = client.list_project_keys()

    results = []
    errors = []
    project_reports = []

    totals = {
        "recipes": 0,
        "recipes_read": 0,
        "recipes_failed": 0,
        "notebooks": 0,
        "notebooks_read": 0,
        "notebooks_failed": 0,
        "sql_notebooks": 0,
        "sql_notebooks_read": 0,
        "sql_notebooks_failed": 0
    }

    for project_key in project_keys:
        project_name = project_key

        project_counts = {
            "recipes": 0,
            "recipes_read": 0,
            "recipes_failed": 0,
            "code_notebooks": 0,
            "code_notebooks_read": 0,
            "code_notebooks_failed": 0,
            "sql_notebooks": 0,
            "sql_notebooks_read": 0,
            "sql_notebooks_failed": 0
        }

        start_match_count = len(results)
        start_error_count = len(errors)

        try:
            project = client.get_project(project_key)
            resolved_name = get_project_name(project)
            if resolved_name:
                project_name = resolved_name
        except Exception as exc:
            append_error(
                errors, project_key, project_name, "",
                "Project", "get_project", exc
            )

            project_reports.append({
                "project_key": project_key,
                "project_name": project_name,
                "recipes": 0,
                "recipes_read": 0,
                "recipes_failed": 0,
                "code_notebooks": 0,
                "code_notebooks_read": 0,
                "code_notebooks_failed": 0,
                "sql_notebooks": 0,
                "sql_notebooks_read": 0,
                "sql_notebooks_failed": 0,
                "matches": 0,
                "errors": len(errors) - start_error_count,
                "status": "HATA"
            })
            continue

        # ----------------------------------------------------
        # RECIPE'LER
        # ----------------------------------------------------
        try:
            recipe_items = project.list_recipes()
        except Exception as exc:
            recipe_items = []
            append_error(
                errors, project_key, project_name, "",
                "Recipe", "list_recipes", exc
            )

        project_counts["recipes"] = len(recipe_items)
        totals["recipes"] += len(recipe_items)

        for item in recipe_items:
            recipe_name = safe_name(item, "name", default=str(item))
            recipe_type = safe_name(item, "type", default="unknown")

            try:
                recipe = project.get_recipe(recipe_name)
                settings = recipe.get_settings()
                payload = settings.str_payload

                if payload is None:
                    payload = ""

                if search_names:
                    add_matches(
                        results, pattern, term, case_sensitive,
                        project_key, project_name, recipe_name,
                        "Recipe ({})".format(recipe_type),
                        "recipe_name", recipe_name
                    )

                add_matches(
                    results, pattern, term, case_sensitive,
                    project_key, project_name, recipe_name,
                    "Recipe ({})".format(recipe_type),
                    "recipe_payload", payload
                )

                project_counts["recipes_read"] += 1
                totals["recipes_read"] += 1

            except Exception as exc:
                project_counts["recipes_failed"] += 1
                totals["recipes_failed"] += 1

                append_error(
                    errors, project_key, project_name, recipe_name,
                    "Recipe ({})".format(recipe_type),
                    "get_recipe/get_settings/str_payload", exc
                )

        # ----------------------------------------------------
        # CODE NOTEBOOK'LAR
        # ----------------------------------------------------
        try:
            notebooks = project.list_jupyter_notebooks(
                as_type="objects"
            )
        except Exception as exc:
            notebooks = []
            append_error(
                errors, project_key, project_name, "",
                "Code Notebook", "list_jupyter_notebooks", exc
            )

        project_counts["code_notebooks"] = len(notebooks)
        totals["notebooks"] += len(notebooks)

        for item in notebooks:
            notebook_name = safe_name(
                item, "notebook_name", "name",
                default=str(item)
            )

            try:
                scan_jupyter_notebook(
                    project, project_key, project_name,
                    item, pattern, term, case_sensitive,
                    search_names, results, errors
                )
                project_counts["code_notebooks_read"] += 1
                totals["notebooks_read"] += 1

            except Exception as exc:
                project_counts["code_notebooks_failed"] += 1
                totals["notebooks_failed"] += 1

                append_error(
                    errors, project_key, project_name,
                    notebook_name, "Code Notebook",
                    "get_content/get_cells", exc
                )

        # ----------------------------------------------------
        # SQL NOTEBOOK'LAR
        # ----------------------------------------------------
        try:
            sql_notebooks = project.list_sql_notebooks(
                as_type="objects"
            )
        except Exception as exc:
            sql_notebooks = []
            append_error(
                errors, project_key, project_name, "",
                "SQL Notebook", "list_sql_notebooks", exc
            )

        project_counts["sql_notebooks"] = len(sql_notebooks)
        totals["sql_notebooks"] += len(sql_notebooks)

        for item in sql_notebooks:
            notebook_name = safe_name(
                item, "id", "notebook_id", "name",
                default=str(item)
            )

            try:
                scan_sql_notebook(
                    project, project_key, project_name,
                    item, pattern, term, case_sensitive,
                    search_names, results, errors
                )
                project_counts["sql_notebooks_read"] += 1
                totals["sql_notebooks_read"] += 1

            except Exception as exc:
                project_counts["sql_notebooks_failed"] += 1
                totals["sql_notebooks_failed"] += 1

                append_error(
                    errors, project_key, project_name,
                    notebook_name, "SQL Notebook",
                    "get_content/cells", exc
                )

        match_count = len(results) - start_match_count
        error_count = len(errors) - start_error_count

        if error_count == 0:
            status = "TAMAMLANDI"
        elif (
            project_counts["recipes_read"]
            + project_counts["code_notebooks_read"]
            + project_counts["sql_notebooks_read"]
        ) > 0:
            status = "KISMEN TAMAMLANDI"
        else:
            status = "HATA"

        project_reports.append({
            "project_key": project_key,
            "project_name": project_name,
            **project_counts,
            "matches": match_count,
            "errors": error_count,
            "status": status
        })

    # Tekrarlanan eslesmeleri kaldir
    seen = set()
    unique_results = []

    for row in results:
        key = (
            row["project_key"], row["object_name"],
            row["object_type"], row["source"],
            row["line_number"], row["matched_text"],
            row["line_text"]
        )
        if key not in seen:
            seen.add(key)
            unique_results.append(row)

    summary = {
        "projects": len(project_keys),
        **totals,
        "matches": len(unique_results),
        "errors": len(errors),
        "duration_seconds": round(time.time() - started, 2)
    }

    return {
        "ok": True,
        "summary": summary,
        "results": unique_results,
        "projects": project_reports,
        "errors": errors
    }


@app.route("/api/search", methods=["POST"])
def search_endpoint():
    body = request.get_json(silent=True) or {}

    term = str(body.get("term", "")).strip()

    if not term:
        return jsonify({
            "ok": False,
            "error": "Arama terimi bos olamaz."
        }), 400

    if len(term) > 300:
        return jsonify({
            "ok": False,
            "error": "Arama terimi en fazla 300 karakter olabilir."
        }), 400

    try:
        result = run_global_search(
            term=term,
            case_sensitive=bool(body.get("case_sensitive", False)),
            search_names=bool(body.get("search_names", True))
        )
        return jsonify(result)

    except Exception as exc:
        return jsonify({
            "ok": False,
            "error": "{}: {}".format(type(exc).__name__, str(exc)),
            "traceback": traceback.format_exc()[-5000:]
        }), 500



