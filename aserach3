import json
import logging
import re
import time

import dataiku
from flask import request, jsonify

logger = logging.getLogger(__name__)


# ------------------------------------------------------------
# Genel yardımcılar
# ------------------------------------------------------------

def get_value(obj, *names, default=None):
    """Dict veya nesne üzerinden olası alan adlarını dener."""
    for name in names:
        try:
            if isinstance(obj, dict):
                value = obj.get(name)
            else:
                value = getattr(obj, name, None)

            if value is not None:
                return value
        except Exception:
            pass

    return default


def to_text(value):
    """Metin, liste, dict veya notebook source içeriğini metne çevirir."""
    if value is None:
        return ""

    if isinstance(value, str):
        return value

    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")

    if isinstance(value, (list, tuple)):
        return "\n".join(to_text(item) for item in value)

    if isinstance(value, dict):
        for key in ("source", "query", "sql", "code", "text", "content"):
            if key in value:
                result = to_text(value[key])
                if result:
                    return result

        try:
            return json.dumps(value, ensure_ascii=False, default=str, indent=2)
        except Exception:
            return str(value)

    # Dataiku notebook cell nesnelerinde sık kullanılan alanlar
    for key in ("source", "query", "sql", "code", "text", "content"):
        value2 = get_value(value, key)
        if value2 is not None:
            result = to_text(value2)
            if result:
                return result

    return str(value)


def get_name(obj, *candidates):
    value = get_value(obj, *candidates)
    if value is None and isinstance(obj, str):
        value = obj
    return str(value) if value is not None else ""


def get_project_label(project, project_key):
    try:
        metadata = project.get_metadata()
        raw = metadata.get_raw()
        label = raw.get("label") or raw.get("name")
        if label:
            return str(label)
    except Exception:
        pass

    return str(project_key)


def object_name_matches(name, term, case_sensitive):
    if not name:
        return False

    if case_sensitive:
        return term in name

    return term.casefold() in name.casefold()


def find_matches(text, term, case_sensitive):
    """Metindeki eşleşmeleri satır numarası ve kısa bağlamla bulur."""
    if not text:
        return []

    lines = str(text).splitlines()
    matches = []

    for index, line in enumerate(lines):
        found = (
            term in line
            if case_sensitive
            else term.casefold() in line.casefold()
        )

        if not found:
            continue

        start = max(0, index - 1)
        end = min(len(lines), index + 2)

        context = "\n".join(
            f"{line_no + 1}: {lines[line_no]}"
            for line_no in range(start, end)
        )

        matches.append({
            "line": index + 1,
            "match": line.strip()[:1000],
            "context": context[:2500]
        })

    return matches


def add_name_match(results, project_label, object_name, object_type,
                   term, case_sensitive):
    if object_name_matches(object_name, term, case_sensitive):
        results.append({
            "project": project_label,
            "object": object_name,
            "type": object_type,
            "source": "Object name",
            "line": "—",
            "match": object_name,
            "context": "Eşleşme nesne adında bulundu."
        })


def scan_text(results, project_label, object_name, object_type,
              source_name, text, term, case_sensitive):
    for match in find_matches(text, term, case_sensitive):
        results.append({
            "project": project_label,
            "object": object_name,
            "type": object_type,
            "source": source_name,
            "line": match["line"],
            "match": match["match"],
            "context": match["context"]
        })


def record_error(errors, project_label, object_name, object_type, exc):
    message = str(exc).strip() or type(exc).__name__

    errors.append({
        "project": project_label,
        "object": object_name or "(bilinmiyor)",
        "type": object_type,
        "error": message[:1500]
    })

    logger.warning(
        "Code search read error: project=%s object=%s type=%s error=%s",
        project_label, object_name, object_type, message,
        exc_info=True
    )


def get_notebook_cells(content):
    """Notebook içeriğinden hücre listesini farklı API şekillerinde alır."""
    if content is None:
        return []

    cells = get_value(content, "cells")
    if cells is not None:
        return list(cells)

    get_cells = get_value(content, "get_cells")
    if callable(get_cells):
        return list(get_cells())

    return []


def get_cell_source(cell):
    for key in ("source", "query", "sql", "code", "text"):
        value = get_value(cell, key)
        if value is not None:
            return to_text(value)

    return ""


# ------------------------------------------------------------
# Recipe taraması
# ------------------------------------------------------------

def scan_recipes(project, project_key, project_label, term,
                 case_sensitive, search_names, results, errors,
                 counts):
    try:
        recipes = project.list_recipes()
    except Exception as exc:
        record_error(
            errors, project_label, "(recipe listesi)", "Recipe", exc
        )
        return

    for item in recipes:
        recipe_name = get_name(item, "name", "recipe_name", "id")

        if not recipe_name:
            record_error(
                errors, project_label, "(recipe adı alınamadı)",
                "Recipe", "Recipe adı belirlenemedi."
            )
            continue

        try:
            recipe = project.get_recipe(recipe_name)
            settings = recipe.get_settings()

            # DSS recipe ayarlarının JSON metin temsili
            payload = get_value(settings, "str_payload")

            if payload is None:
                raw = settings.get_raw()
                payload = json.dumps(
                    raw, ensure_ascii=False, default=str, indent=2
                )

            counts["recipes_read"] += 1

            if search_names:
                add_name_match(
                    results, project_label, recipe_name, "Recipe",
                    term, case_sensitive
                )

            scan_text(
                results, project_label, recipe_name, "Recipe",
                "Recipe settings", to_text(payload),
                term, case_sensitive
            )

        except Exception as exc:
            record_error(
                errors, project_label, recipe_name, "Recipe", exc
            )


# ------------------------------------------------------------
# Python / Jupyter notebook taraması
# ------------------------------------------------------------

def scan_python_notebooks(project, project_label, term,
                          case_sensitive, search_names,
                          results, errors, counts):
    try:
        notebooks = project.list_jupyter_notebooks(as_type="objects")
    except Exception as exc:
        record_error(
            errors, project_label, "(Python notebook listesi)",
            "Python Notebook", exc
        )
        return

    for item in notebooks:
        name = get_name(
            item, "notebook_name", "name", "id", "notebook_id"
        )

        if not name:
            record_error(
                errors, project_label, "(notebook adı alınamadı)",
                "Python Notebook", "Notebook adı belirlenemedi."
            )
            continue

        try:
            notebook = project.get_jupyter_notebook(name)
            content = notebook.get_content()
            cells = get_notebook_cells(content)
            counts["python_notebooks_read"] += 1

            if search_names:
                add_name_match(
                    results, project_label, name, "Python Notebook",
                    term, case_sensitive
                )

            for cell_index, cell in enumerate(cells, start=1):
                source = get_cell_source(cell)
                if not source:
                    continue

                cell_type = get_value(cell, "cell_type", "type")
                if cell_type and str(cell_type).lower() not in (
                    "code", "python", "input"
                ):
                    continue

                scan_text(
                    results, project_label, name, "Python Notebook",
                    f"Cell {cell_index}", source,
                    term, case_sensitive
                )

        except Exception as exc:
            record_error(
                errors, project_label, name, "Python Notebook", exc
            )


# ------------------------------------------------------------
# SQL notebook taraması
# ------------------------------------------------------------

def scan_sql_notebooks(project, project_label, term,
                       case_sensitive, search_names,
                       results, errors, counts):
    try:
        notebooks = project.list_sql_notebooks(as_type="objects")
    except Exception as exc:
        record_error(
            errors, project_label, "(SQL notebook listesi)",
            "SQL Notebook", exc
        )
        return

    for item in notebooks:
        name = get_name(
            item, "notebook_id", "id", "name", "notebook_name"
        )

        if not name:
            record_error(
                errors, project_label, "(SQL notebook adı alınamadı)",
                "SQL Notebook", "Notebook kimliği belirlenemedi."
            )
            continue

        try:
            notebook = project.get_sql_notebook(name)
            content = notebook.get_content()
            cells = get_notebook_cells(content)
            counts["sql_notebooks_read"] += 1

            if search_names:
                add_name_match(
                    results, project_label, name, "SQL Notebook",
                    term, case_sensitive
                )

            # Bazı DSS sürümlerinde SQL notebook hücre yerine
            # query/text alanı içerebilir.
            if not cells:
                raw_text = to_text(content)
                scan_text(
                    results, project_label, name, "SQL Notebook",
                    "Notebook content", raw_text,
                    term, case_sensitive
                )
                continue

            for cell_index, cell in enumerate(cells, start=1):
                source = get_cell_source(cell)
                if not source:
                    continue

                scan_text(
                    results, project_label, name, "SQL Notebook",
                    f"Cell {cell_index}", source,
                    term, case_sensitive
                )

        except Exception as exc:
            record_error(
                errors, project_label, name, "SQL Notebook", exc
            )


# ------------------------------------------------------------
# Global arama
# ------------------------------------------------------------

def run_global_search(term, case_sensitive=False, search_names=True):
    started = time.time()

    results = []
    errors = []
    project_rows = []

    total = {
        "projects_read": 0,
        "recipes_read": 0,
        "python_notebooks_read": 0,
        "sql_notebooks_read": 0
    }

    client = dataiku.api_client()
    project_keys = client.list_project_keys()

    for project_key in project_keys:
        project_key = str(project_key)
        project_label = project_key

        counts = {
            "recipes_read": 0,
            "python_notebooks_read": 0,
            "sql_notebooks_read": 0
        }

        try:
            project = client.get_project(project_key)
            project_label = get_project_label(project, project_key)
            total["projects_read"] += 1
        except Exception as exc:
            record_error(
                errors, project_label, "(project)", "Project", exc
            )
            continue

        scan_recipes(
            project, project_key, project_label, term,
            case_sensitive, search_names, results, errors, counts
        )

        scan_python_notebooks(
            project, project_label, term, case_sensitive,
            search_names, results, errors, counts
        )

        scan_sql_notebooks(
            project, project_label, term, case_sensitive,
            search_names, results, errors, counts
        )

        project_matches = sum(
            1 for row in results if row["project"] == project_label
        )

        project_rows.append({
            "project": project_label,
            "recipes_read": counts["recipes_read"],
            "python_notebooks_read": counts["python_notebooks_read"],
            "sql_notebooks_read": counts["sql_notebooks_read"],
            "matches_found": project_matches
        })

        for key in counts:
            total[key] += counts[key]

    summary = {
        "projects_read": total["projects_read"],
        "recipes_read": total["recipes_read"],
        "python_notebooks_read": total["python_notebooks_read"],
        "sql_notebooks_read": total["sql_notebooks_read"],
        "matches_found": len(results),
        "errors_count": len(errors),
        "duration_seconds": round(time.time() - started, 2)
    }

    return {
        "summary": summary,
        "results": results,
        "projects": sorted(
            project_rows, key=lambda row: row["project"].casefold()
        ),
        "errors": errors
    }


