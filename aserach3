const $ = id => document.getElementById(id);

let allResults = [];
let allProjects = [];
let allErrors = [];
let filteredResults = [];
let hasSearchResults = false;

function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, ch => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[ch]);
}

function setStatus(message, type = "") {
    $("status").textContent = message;
    $("status").className = "status" + (type ? " " + type : "");
}

function renderRows(tableId, rows, columns) {
    const tbody = $(tableId);

    if (!rows || rows.length === 0) {
        tbody.innerHTML =
            `<tr><td colspan="${columns.length}" class="empty-cell">Gösterilecek kayıt yok.</td></tr>`;
        return;
    }

    tbody.innerHTML = rows.map(row => {
        const cells = columns.map(col => {
            const value = row[col.key] ?? "";
            let content = escapeHtml(value);

            if (col.key === "type") {
                content = `<span class="type-pill">${content}</span>`;
            } else if (col.key === "match") {
                content = `<span class="match-text">${content}</span>`;
            } else if (col.key === "context") {
                content = `<span class="context-text">${content}</span>`;
            }

            return `<td>${content}</td>`;
        }).join("");

        return `<tr>${cells}</tr>`;
    }).join("");
}

function populateSelect(id, values, defaultLabel) {
    const select = $(id);
    const oldValue = select.value;
    const uniqueValues = [...new Set(
        values.filter(v => v !== undefined && v !== null && String(v) !== "")
            .map(String)
    )].sort((a, b) => a.localeCompare(b));

    select.replaceChildren();

    const first = document.createElement("option");
    first.value = "";
    first.textContent = defaultLabel;
    select.appendChild(first);

    uniqueValues.forEach(value => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
    });

    if (uniqueValues.includes(oldValue)) {
        select.value = oldValue;
    }
}

function updateMetrics(summary = {}) {
    $("metricProjects").textContent = summary.projects_read ?? 0;
    $("metricRecipes").textContent = summary.recipes_read ?? 0;

    const notebooks =
        Number(summary.python_notebooks_read ?? 0) +
        Number(summary.sql_notebooks_read ?? 0);

    $("metricNotebooks").textContent = notebooks;
    $("metricMatches").textContent = summary.matches_found ?? 0;
    $("metricErrors").textContent = summary.errors_count ?? 0;
}

function getLineRange() {
    const raw = $("lineFilter").value.trim();

    if (!raw) return null;

    let match = raw.match(/^(\d+)$/);
    if (match) {
        return { min: Number(match[1]), max: Number(match[1]) };
    }

    match = raw.match(/^(\d+)\s*-\s*(\d+)$/);
    if (match) {
        return {
            min: Math.min(Number(match[1]), Number(match[2])),
            max: Math.max(Number(match[1]), Number(match[2]))
        };
    }

    return false;
}

function applyFilters() {
    const project = $("projectFilter").value;
    const type = $("typeFilter").value;
    const range = getLineRange();
    const limit = Number($("limitFilter").value);
    const dedupe = $("dedupeFilter").checked;

    if (range === false) {
        $("filterSummary").textContent =
            "Satır filtresi için 25 veya 25-80 biçimini kullan.";
        return;
    }

    let rows = allResults.filter(row => {
        if (project && String(row.project) !== project) return false;
        if (type && String(row.type) !== type) return false;

        if (range) {
            const line = Number(row.line);
            if (!Number.isFinite(line) || line < range.min || line > range.max) {
                return false;
            }
        }
        return true;
    });

    const afterBasicFilters = rows.length;

    if (dedupe) {
        const seen = new Set();

        rows = rows.filter(row => {
            const key = JSON.stringify([
                row.project, row.object, row.type,
                row.source, row.line, row.match
            ]);

            if (seen.has(key)) return false;
            seen.add(key);
            return true;
        });
    }

    const afterDedupe = rows.length;

    if (limit > 0) {
        const counts = new Map();

        rows = rows.filter(row => {
            const key = JSON.stringify([row.project, row.object, row.type]);
            const count = counts.get(key) || 0;

            if (count >= limit) return false;

            counts.set(key, count + 1);
            return true;
        });
    }

    filteredResults = rows;

    renderRows("resultsTable", rows, [
        { key: "project" },
        { key: "object" },
        { key: "type" },
        { key: "source" },
        { key: "line" },
        { key: "match" },
        { key: "context" }
    ]);

    $("filterSummary").textContent =
        `${rows.length} gösteriliyor · ` +
        `${afterBasicFilters - afterDedupe} tekrar gizlendi · ` +
        `${afterDedupe - rows.length} limit nedeniyle gizlendi`;
}

function displaySearchResult(data) {
    allResults = Array.isArray(data.results) ? data.results : [];
    allProjects = Array.isArray(data.projects) ? data.projects : [];
    allErrors = Array.isArray(data.errors) ? data.errors : [];
    hasSearchResults = true;

    updateMetrics(data.summary || {});

    populateSelect(
        "projectFilter",
        allResults.map(row => row.project),
        "Tüm projeler"
    );

    populateSelect(
        "typeFilter",
        allResults.map(row => row.type),
        "Tüm türler"
    );

    renderRows("projectsTable", allProjects, [
        { key: "project" },
        { key: "recipes_read" },
        { key: "python_notebooks_read" },
        { key: "sql_notebooks_read" },
        { key: "matches_found" }
    ]);

    renderRows("errorsTable", allErrors, [
        { key: "project" },
        { key: "object" },
        { key: "type" },
        { key: "error" }
    ]);

    $("exportButton").disabled = allResults.length === 0;
    applyFilters();
}

async function runSearch() {
    const term = $("searchTerm").value.trim();

    if (!term) {
        setStatus("Lütfen aranacak bir ifade gir.", "error");
        $("searchTerm").focus();
        return;
    }

    $("searchButton").disabled = true;
    $("searchButtonText").textContent = "Aranıyor...";
    setStatus("Projeler ve kod nesneleri taranıyor. Büyük projelerde işlem sürebilir.", "loading");

    try {
        const response = await fetch(getWebAppBackendUrl("/api/search"), {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                term: term,
                case_sensitive: $("caseSensitive").checked,
                search_names: $("searchNames").checked
            })
        });

        const body = await response.text();
        let data;

        try {
            data = JSON.parse(body);
        } catch (parseError) {
            throw new Error(
                "Backend JSON yerine farklı bir yanıt döndürdü. HTTP " +
                response.status + ". Yanıt: " + body.substring(0, 350)
            );
        }

        if (!response.ok) {
            throw new Error(data.error || "HTTP " + response.status);
        }

        if (data.error) {
            throw new Error(data.error);
        }

        displaySearchResult(data);
        setStatus(
            `Arama tamamlandı. ${allResults.length} ham eşleşme, ` +
            `${allErrors.length} okuma hatası.`,
            "success"
        );
    } catch (error) {
        console.error("Global Code Search:", error);
        setStatus("Arama başarısız: " + error.message, "error");
    } finally {
        $("searchButton").disabled = false;
        $("searchButtonText").textContent = "⌕ Ara";
    }
}

function exportCsv() {
    if (!filteredResults.length) {
        setStatus("Dışa aktarılacak filtrelenmiş sonuç bulunamadı.", "error");
        return;
    }

    const columns = [
        ["project", "Project"],
        ["object", "Object"],
        ["type", "Type"],
        ["source", "Source"],
        ["line", "Line"],
        ["match", "Match"],
        ["context", "Context"]
    ];

    const quote = value =>
        '"' + String(value ?? "").replace(/"/g, '""') + '"';

    const lines = [
        columns.map(col => quote(col[1])).join(","),
        ...filteredResults.map(row =>
            columns.map(col => quote(row[col[0]])).join(",")
        )
    ];

    const blob = new Blob(
        ["\uFEFF" + lines.join("\r\n")],
        { type: "text/csv;charset=utf-8;" }
    );

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "global_code_search.csv";
    link.click();
    URL.revokeObjectURL(url);
}

