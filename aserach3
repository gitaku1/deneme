@app.route("/api/search", methods=["POST"])
def api_search():
    try:
        payload = request.get_json(silent=True) or {}

        term = str(payload.get("term") or "").strip()
        case_sensitive = bool(payload.get("case_sensitive", False))
        search_names = bool(payload.get("search_names", True))

        if not term:
            return jsonify({"error": "Aranacak ifade boş olamaz."}), 400

        if len(term) > 300:
            return jsonify({
                "error": "Aranacak ifade en fazla 300 karakter olabilir."
            }), 400

        result = run_global_search(
            term=term,
            case_sensitive=case_sensitive,
            search_names=search_names
        )

        return jsonify(result)

    except Exception as exc:
        logger.exception("Global Code Search failed")
        return jsonify({
            "error": str(exc)[:1500]
        }), 500
