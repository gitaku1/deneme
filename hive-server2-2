apiVersion: apps/v1
kind: Deployment
metadata:
  name: hiveserver2-deployment
  namespace: <NAMESPACE_ISMINIZ> # Çalıştığınız K8s / OpenShift namespace
  labels:
    app: hiveserver2
spec:
  replicas: 1 # HiveServer2 stateful oturumlar tuttuğu için varsayılan 1 replica önerilir
  selector:
    matchLabels:
      app: hiveserver2
  template:
    metadata:
      labels:
        app: hiveserver2
    spec:
      containers:
      - name: hiveserver2
        image: <REGISTRY_ADRESINIZ>/<PROJECT_NAME>/hive-server2:v1.0
        imagePullPolicy: Always
        ports:
        - containerPort: 10051
          name: thrift
        - containerPort: 10002
          name: webui
        resources:
          requests:
            memory: "4Gi"
            cpu: "2"
          limits:
            memory: "8Gi"
            cpu: "4"
        # Sağlık Kontrolleri (Liveness & Readiness)
        readinessProbe:
          tcpSocket:
            port: 10051
          initialDelaySeconds: 30
          periodSeconds: 10
        livenessProbe:
          tcpSocket:
            port: 10051
          initialDelaySeconds: 60
          periodSeconds: 20
---
apiVersion: v1
kind: Service
metadata:
  name: hiveserver2-service
  namespace: <NAMESPACE_ISMINIZ>
spec:
  type: NodePort # Veya Ingress / LoadBalancer kullanıyorsanız ClusterIP
  selector:
    app: hiveserver2
  ports:
  - name: thrift
    port: 10051
    targetPort: 10051
    nodePort: 30051 # Dışarıdan erişim için kullanılacak sabit NodePort (30000-32767 arası)
  - name: webui
    port: 10002
    targetPort: 10002


















  kubectl apply -f hs2-k8s.yaml -n <NAMESPACE_ISMINIZ>


  kubectl get pods -l app=hiveserver2 -n <NAMESPACE_ISMINIZ>

  kubectl logs -f deployment/hiveserver2-deployment -n <NAMESPACE_ISMINIZ>

  beeline -u "jdbc:hive2://<K8S_NODE_IP>:30051/default"
