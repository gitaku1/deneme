import dataiku
import json
import os

STATE_FILE = "kube_config_state.json"

def adim1_listele_ve_onizle(yeni_kube_path):
    client = dataiku.api_client()
    print("=== [1. KOD] Container Execution / Kube Config Tarama Başlatıldı ===")
    
    bulunan_ogeler = []
    
    # 1. Yöntem: Standart Cluster'ları Tara
    try:
        clusters = client.list_clusters()
        for c in clusters:
            cluster_id = c['id']
            cluster_obj = client.get_cluster(cluster_id)
            settings = cluster_obj.get_settings()
            params = settings.get('params', {})
            
            # Kube config anahtarının olası varyasyonlarını kontrol et
            current_path = (params.get('kubeConfigPath') or 
                            params.get('kubeconfig') or 
                            params.get('kubeConfig') or 
                            params.get('configPath'))
            
            if current_path or 'kube' in str(params).lower():
                print(f"[Cluster Bulundu] ID: {cluster_id} | Mevcut Yol: {current_path or 'Bulunamadı (Parametrelerde var)'}")
                bulunan_ogeler.append({
                    'tip': 'cluster',
                    'id': cluster_id,
                    'eski_yol': current_path or '',
                    'yeni_yol': yeni_kube_path
                })
    except Exception as e:
        print(f"Cluster tarama uyarısı: {str(e)}")

    # 2. Yöntem: Container Executions / Additional Settings Tarama (Dataiku API Genişletme)
    # Eğer cluster listesinde bulunamazsa, DSS instance genel parametreleri veya container templates taranır
    try:
        # DSS mimarisine göre container execution şablonları veya connection ayarları
        if hasattr(client, 'list_container_templates'):
            templates = client.list_container_templates()
            for t in templates:
                t_id = t.get('id') or t.get('name')
                t_obj = client.get_container_template(t_id)
                t_settings = t_obj.get_settings()
                t_params = t_settings.get('params', {})
                
                current_path = (t_params.get('kubeConfigPath') or 
                                t_params.get('kubeconfig') or 
                                t_params.get('kubeConfig'))
                
                if current_path:
                    print(f"[Container Template Bulundu] ID: {t_id} | Mevcut Yol: {current_path}")
                    bulunan_ogeler.append({
                        'tip': 'container_template',
                        'id': t_id,
                        'eski_yol': current_path,
                        'yeni_yol': yeni_kube_path
                    })
    except Exception as e:
        pass

    if not bulunan_ogeler:
        print("\n[Uyarı] Otomatik taramada kube config path içeren bir kayıt bulunamadı.")
        print("Lütfen Dataiku üzerindeki tam cluster ID'nizi veya konfigürasyon adınızı kontrol edin.")
    else:
        state_data = {'ogeler': bulunan_ogeler}
        with open(STATE_FILE, 'w', encoding='utf-8') as f:
            json.dump(state_data, f, indent=4)
        print(f"\n[Başarılı] Toplam {len(bulunan_ogeler)} adet konfigürasyon bulundu ve '{STATE_FILE}' dosyasına kaydedildi.")

if __name__ == "__main__":
    # Kendi yeni kube config path'inizi buraya yazın:
    adim1_listele_ve_onizle(yeni_kube_path="/home/users/.kube/config")












import dataiku
import json
import os

STATE_FILE = "kube_config_state.json"

def adim2_kaydet_ve_uygula():
    print("=== [2. KOD] Kube Config Değişiklikleri Kaydediliyor ===")
    
    if not os.path.exists(STATE_FILE):
        print(f"Hata: Önce 1. kodu çalıştırmalısınız! ({STATE_FILE} bulunamadı)")
        return
        
    with open(STATE_FILE, 'r', encoding='utf-8') as f:
        state_data = json.load(f)
        
    client = dataiku.api_client()
    
    for item in state_data.get('ogeler', []):
        tip = item['tip']
        og_id = item['id']
        yeni_yol = item['yeni_yol']
        
        if tip == 'cluster':
            cluster_obj = client.get_cluster(og_id)
            settings = cluster_obj.get_settings()
            params = settings.get('params', {})
            
            if 'kubeConfigPath' in params:
                params['kubeConfigPath'] = yeni_yol
            elif 'kubeconfig' in params:
                params['kubeconfig'] = yeni_yol
            else:
                params['kubeConfigPath'] = yeni_yol
                
            cluster_obj.save()
            print(f"[Cluster Güncellendi] ID: {og_id} -> Yeni Yol: {yeni_yol}")
            
        elif tip == 'container_template':
            t_obj = client.get_container_template(og_id)
            settings = t_obj.get_settings()
            params = settings.get('params', {})
            
            if 'kubeConfigPath' in params:
                params['kubeConfigPath'] = yeni_yol
            elif 'kubeconfig' in params:
                params['kubeconfig'] = yeni_yol
            else:
                params['kubeConfigPath'] = yeni_yol
                
            t_obj.save()
            print(f"[Container Template Güncellendi] ID: {og_id} -> Yeni Yol: {yeni_yol}")
            
    print("\n[Bilgi] Kayıt ve güncelleme işlemi başarıyla tamamlandı.")

if __name__ == "__main__":
    adim2_kaydet_ve_uygula()


















