import dataiku
import re
import json
import os

STATE_FILE = "kube_config_state.json"

# Değiştirmek istediğiniz eski kalıp (örn: içerisindeki herhangi bir eski path veya wildcard) ve YENİ path
OLD_PATTERN = "/home/dataiku/.kube"  # Kapsamlı yakalamak için ana kök dizin veya eski path kalıbı
NEW_PATH = "/home/users/.kube"      # Yazmak istediğiniz yeni dizin

def adim1_listele_ve_onizle():
    client = dataiku.api_client()
    settings = client.get_general_settings()
    raw_settings = settings.get_raw()

    regex_pattern = re.escape(OLD_PATTERN).replace(r"\*", ".*")
    changes = []

    # Sadece containerSettings -> executionConfigs altındaki 40+ tanımı hedefleyen tarayıcı
    def scan_configs(obj, path="root"):
        if isinstance(obj, dict):
            for k, v in obj.items():
                current_path = f"{path}.{k}"
                if isinstance(v, (dict, list)):
                    scan_configs(v, current_path)
                elif isinstance(v, str):
                    # Kube config path içeren anahtarları veya içinde .kube geçen değerleri yakala
                    if 'kube' in k.lower() or 'kube' in v.lower():
                        # Eğer zaten yeni path ile aynı değilse listeye ekle
                        if v != NEW_PATH:
                            changes.append({
                                'path': current_path,
                                'eski_yol': v,
                                'yeni_yol': NEW_PATH
                            })
        elif isinstance(obj, list):
            for i, v in enumerate(obj):
                current_path = f"{path}[{i}]"
                if isinstance(v, (dict, list)):
                    scan_configs(v, current_path)
                elif isinstance(v, str):
                    if 'kube' in v.lower():
                        if v != NEW_PATH:
                            changes.append({
                                'path': current_path,
                                'eski_yol': v,
                                'yeni_yol': NEW_PATH
                            })

    # Hedef alanı doğrudan executionConfigs altından başlatıyoruz
    container_settings = raw_settings.get("containerSettings", {})
    execution_configs = container_settings.get("executionConfigs", [])

    print(f"Bilgi: Toplam {len(execution_configs)} adet container execution yapılandırması inceleniyor...\n")

    for i, cfg in enumerate(execution_configs):
        scan_configs(cfg, f"executionConfigs[{i}]")

    print(f"=== [1. ADIM] BULUNAN TOPLAM KUBE CONFIG TANIMI: {len(changes)} ===")
    
    if not changes:
        print("[Uyarı] Hiçbir kube config tanımı bulunamadı!")
        return

    # İlk 10 tanesini ekrana yazdırıp örnek gösterelim (40 taneyi boğmamak için)
    for item in changes[:10]:
        print(f"PATH : {item['path']}")
        print(f"ESKI : {item['eski_yol']}")
        print(f"YENİ : {item['yeni_yol']}")
        print("-" * 30)
    
    if len(changes) > 10:
        print(f"... ve benzeri toplam {len(changes)} adet tanım bulundu.")

    # 2. ve 3. adım için verileri kaydet
    state_data = {
        'new_path': NEW_PATH,
        'changes': changes
    }
    with open(STATE_FILE, 'w', encoding='utf-8') as f:
        json.dump(state_data, f, indent=4)
        
    print(f"\n[Başarılı] Tüm eşleşmeler '{STATE_FILE}' dosyasına kaydedildi. Şimdi 2. adıma geçebilirsiniz.")

if __name__ == "__main__":
    adim1_listele_ve_onizle()
