import dataiku
import json

STATE_FILE = "kube_config_state.json"

def adim1_listele_ve_onizle(yeni_kube_path):
    client = dataiku.api_client()
    print("=== [1. KOD] Mevcut Kube Config Değerleri Listeleniyor ===")
    
    try:
        clusters = client.list_clusters()
    except Exception as e:
        print(f"Cluster'lar listelenirken hata oluştu: {str(e)}")
        return
    
    onizleme_listesi = []
    for c in clusters:
        cluster_id = c['id']
        cluster_obj = client.get_cluster(cluster_id)
        settings = cluster_obj.get_settings()
        params = settings.get('params', {})
        
        current_path = params.get('kubeConfigPath', params.get('kubeconfig', 'Bulunamadı'))
        
        print(f"\n[Cluster ID]: {cluster_id}")
        print(f"  -> Mevcut Yol : {current_path}")
        print(f"  -> Yeni Yazılacak Yol: {yeni_kube_path}")
        
        onizleme_listesi.append({
            'cluster_id': cluster_id,
            'eski_yol': current_path,
            'yeni_yol': yeni_kube_path
        })
        
    state_data = {'clusters': onizleme_listesi}
    with open(STATE_FILE, 'w', encoding='utf-8') as f:
        json.dump(state_data, f, indent=4)
        
    print(f"\n[Bilgi] Listeleme tamamlandı. Durum '{STATE_FILE}' dosyasına kaydedildi. Herhangi bir değişiklik yapılmadı.")

if __name__ == "__main__":
    # Yeni set etmek istediğiniz dizini buraya yazın:
    adim1_listele_ve_onizle(yeni_kube_path="/home/users/.kube/config")


















import dataiku
import json
import os

STATE_FILE = "kube_config_state.json"

def adim2_kaydet_ve_uygula():
    print("=== [2. KOD] Değişiklikler Kaydediliyor ===")
    
    if not os.path.exists(STATE_FILE):
        print(f"Hata: Önce 1. kodu çalıştırmalısınız! ({STATE_FILE} bulunamadı)")
        return
        
    with open(STATE_FILE, 'r', encoding='utf-8') as f:
        state_data = json.load(f)
        
    client = dataiku.api_client()
    
    for item in state_data['clusters']:
        cluster_id = item['cluster_id']
        yeni_yol = item['yeni_yol']
        
        cluster_obj = client.get_cluster(cluster_id)
        settings = cluster_obj.get_settings()
        params = settings.get('params', {})
        
        if 'kubeConfigPath' in params:
            params['kubeConfigPath'] = yeni_yol
        elif 'kubeconfig' in params:
            params['kubeconfig'] = yeni_yol
        else:
            params['kubeConfigPath'] = yeni_yol
            
        cluster_obj.save()
        print(f"[Başarılı] Cluster güncellendi: {cluster_id} -> Yeni yol: {yeni_yol}")
        
    print("\n[Bilgi] Kayıt işlemi tamamlandı.")

if __name__ == "__main__":
    adim2_kaydet_ve_uygula()



























import dataiku
import json
import os

STATE_FILE = "kube_config_state.json"

def adim3_geri_al():
    print("=== [3. KOD] Rollback (Geri Alma) Başlatıldı ===")
    
    if not os.path.exists(STATE_FILE):
        print(f"Hata: Geri alınacak durum dosyası bulunamadı ({STATE_FILE})!")
        return
        
    with open(STATE_FILE, 'r', encoding='utf-8') as f:
        state_data = json.load(f)
        
    client = dataiku.api_client()
    
    for item in state_data['clusters']:
        cluster_id = item['cluster_id']
        eski_yol = item['eski_yol']
        
        cluster_obj = client.get_cluster(cluster_id)
        settings = cluster_obj.get_settings()
        params = settings.get('params', {})
        
        if 'kubeConfigPath' in params:
            params['kubeConfigPath'] = eski_yol
        elif 'kubeconfig' in params:
            params['kubeconfig'] = eski_yol
        else:
            params['kubeConfigPath'] = eski_yol
            
        cluster_obj.save()
        print(f"[Geri Alındı] Cluster eski orijinal haline getirildi: {cluster_id} -> {eski_yol}")
        
    print("\n[Bilgi] Rollback başarıyla tamamlandı. Her şey eski haline döndü.")

if __name__ == "__main__":
    adim3_geri_al()







    
