import dataiku
import re
import json
import os

STATE_FILE = "kube_config_state.json"

# Aranacak eski kalıp (Joker içerebilir) ve yeni değer
OLD = "/home/dataiku/.kube/path/*"
NEW = "/home/dataiku/.kube/yenipath/abc/dataiku-pod"

def adim1_listele_ve_onizle():
    client = dataiku.api_client()
    settings = client.get_general_settings()
    raw_settings = settings.get_raw()

    regex_pattern = re.escape(OLD).replace(r"\*", ".*")
    changes = []

    def find_and_preview(obj, path="root"):
        if isinstance(obj, dict):
            for k in list(obj.keys()):
                v = obj[k]
                if isinstance(v, (dict, list)):
                    find_and_preview(v, f"{path}.{k}")
                elif isinstance(v, str):
                    if re.search(regex_pattern, v):
                        new_val = re.sub(regex_pattern, NEW, v)
                        changes.append({
                            'path': f"{path}.{k}",
                            'eski_yol': v,
                            'yeni_yol': new_val
                        })
        elif isinstance(obj, list):
            for i in range(len(obj)):
                v = obj[i]
                if isinstance(v, (dict, list)):
                    find_and_preview(v, f"{path}[{i}]")
                elif isinstance(v, str):
                    if re.search(regex_pattern, v):
                        new_val = re.sub(regex_pattern, NEW, v)
                        changes.append({
                            'path': f"{path}[{i}]",
                            'eski_yol': v,
                            'yeni_yol': new_val
                        })

    exec_configs = raw_settings.get("containerSettings", {}).get("executionConfigs", [])
    for i, cfg in enumerate(exec_configs):
        find_and_preview(cfg, f"executionConfigs[{i}]")

    print("\n=== [1. ADIM] BULUNAN VE DEĞİŞECEK ALANLAR ==-\n")
    if not changes:
        print("Uyarı: Belirtilen kalıba uyan hiçbir eşleşme bulunamadı!")
        return

    for item in changes:
        print(f"PATH : {item['path']}")
        print(f"ESKI : {item['eski_yol']}")
        print(f"YENİ : {item['yeni_yol']}")
        print("-" * 40)

    print(f"\nToplam Bulunan Değişiklik: {len(changes)}")

    # 2. Adım ve 3. Adım için durumu dosyaya kaydet
    state_data = {
        'old_pattern': OLD,
        'new_pattern': NEW,
        'changes': changes
    }
    with open(STATE_FILE, 'w', encoding='utf-8') as f:
        json.dump(state_data, f, indent=4)
    print(f"\n[Bilgi] Önizleme tamamlandı. Durum '{STATE_FILE}' dosyasına kaydedildi.")

if __name__ == "__main__":
    adim1_listele_ve_onizle()
