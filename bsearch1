import dataiku
import json
import os

STATE_FILE = "kube_config_state.json"

# YENİ SET ETMEK İSTEDİĞİNİZ DİZİN:
NEW_PATH = "/home/users/.kube/config" 

def adim1_listele_ve_onizle():
    client = dataiku.api_client()
    settings = client.get_general_settings()
    raw_settings = settings.get_raw()

    changes = []

    # Sadece containerSettings -> executionConfigs dizisini hedef alıyoruz
    execution_configs = raw_settings.get("containerSettings", {}).get("executionConfigs", [])
    
    print(f"Toplam {len(execution_configs)} adet container execution taranıyor...\n")

    for i, cfg in enumerate(execution_configs):
        # Her execution config içerisindeki parametreleri ve kube config alanlarını kontrol et
        # Genellikle 'kubeConfigPath' veya benzeri bir key'dir.
        # Burada hem key adında 'kube' ve 'path' geçenleri hem de params altındaki alanları inceliyoruz.
        
        def find_kube_paths(obj, current_path):
            if isinstance(obj, dict):
                for k, v in obj.items():
                    full_p = f"{current_path}.{k}"
                    # Eğer anahtar adında kube ve config/path geçiyorsa veya değer bir dosya yolu ise
                    if any(key_term in k.lower() for key_term in ['kubeconfig', 'kubeconfigpath', 'kubepath', 'configpath']):
                        if isinstance(v, str):
                            changes.append({
                                'path': full_p,
                                'eski_yol': v,
                                'yeni_yol': NEW_PATH
                            })
                    elif isinstance(v, (dict, list)):
                        find_kube_paths(v, full_p)
            elif isinstance(obj, list):
                for idx, item in enumerate(obj):
                    find_kube_paths(item, f"{current_path}[{idx}]")

        find_kube_paths(cfg, f"executionConfigs[{i}]")

    print(f"=== [1. ADIM] BULUNAN GERÇEK KUBE CONFIG SAYISI: {len(changes)} ===")
    
    if not changes:
        print("[Uyarı] Hedef alanlarda uygun kube config path anahtarı bulunamadı!")
        return

    for item in changes:
        print(f"PATH : {item['path']}")
        print(f"ESKI : {item['eski_yol']}")
        print(f"YENİ : {item['yeni_yol']}")
        print("-" * 40)

    # Durumu kaydet
    state_data = {
        'new_path': NEW_PATH,
        'changes': changes
    }
    with open(STATE_FILE, 'w', encoding='utf-8') as f:
        json.dump(state_data, f, indent=4)
        
    print(f"\n[Başarılı] Sadece doğru olan {len(changes)} adet kayıt '{STATE_FILE}' dosyasına yazıldı.")

if __name__ == "__main__":
    adim1_listele_ve_onizle()
